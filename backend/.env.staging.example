# ==============================================================================
# SMART SKILL HUB — BACKEND STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY NOTICE:
# - This template contains PLACEHOLDERS ONLY. Never commit real secrets.
# - In staging / production environments, supply real credentials via secret
#   manager (AWS Secrets Manager, Doppler, Vault, or Render/Railway environment).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE PROCESS & APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8000
API_PREFIX=/api/v1
ADMIN_EMAIL=sampatakumarsv@gmail.com
CORS_ORIGIN=https://staging.smartskillhub.com,http://localhost:8080,http://localhost:8081
FRONTEND_URL=https://staging.smartskillhub.com
APP_BASE_URL=https://staging.smartskillhub.com

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (MANDATORY)
# ------------------------------------------------------------------------------
# In Docker Compose staging: mongodb://mongo:27017/smartskillhub
# In Managed Staging: mongodb+srv://<username>:<password>@staging-cluster.mongodb.net/smartskillhub?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/smartskillhub

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN AUTHENTICATION (MANDATORY)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=your-staging-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-staging@your-staging-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_STAGING_RSA_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_CONTINUE_URL=https://staging.smartskillhub.com/auth/action

# ------------------------------------------------------------------------------
# 4. SUPABASE STORAGE (RESUME ATTACHMENTS & ASSETS)
# ------------------------------------------------------------------------------
# Required for binary resume document persistence; local filesystem fallback active if unreachable
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=resumes
MAX_RESUME_SIZE_MB=10

# ------------------------------------------------------------------------------
# 5. AI INTELLIGENCE & LLM PROVIDER
# ------------------------------------------------------------------------------
# Groq Cloud API Key; local rule-based fallback active if unconfigured or unreachable
GROQ_API_KEY=gsk_your_staging_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 6. EDUTUBE & YOUTUBE DATA API V3 (OPTIONAL)
# ------------------------------------------------------------------------------
# Optional; curated educational curriculum and deterministic classifier active if unconfigured
YOUTUBE_API_KEY=AIzaSy_your_staging_youtube_api_key_here
EDUTUBE_MIN_DURATION_SECONDS=120

# ------------------------------------------------------------------------------
# 7. REMOTE CODING RUNNER & DOCKER SANDBOX (MANDATORY FOR CODING PLAYGROUND)
# ------------------------------------------------------------------------------
# For isolated remote runner daemon: tcp://runner.staging.internal:2376
# For local containerized engine: unix:///var/run/docker.sock
DOCKER_HOST=tcp://runner.staging.internal:2376
DOCKER_TLS_VERIFY=1
DOCKER_CERT_PATH=/etc/docker/certs.d

# ------------------------------------------------------------------------------
# 8. EMAIL DELIVERY & SYSTEM NOTIFICATIONS
# ------------------------------------------------------------------------------
# Providers: resend | smtp | console | mock
EMAIL_PROVIDER=console
EMAIL_FROM="Smart Skill Hub Staging <noreply@staging.smartskillhub.com>"
EMAIL_FROM_NAME="Smart Skill Hub Staging"
EMAIL_API_KEY=your_staging_email_provider_key

# ------------------------------------------------------------------------------
# 9. GITHUB & CLOUDFLARE INTEGRATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_staging_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_staging_github_oauth_client_secret
GITHUB_OAUTH_CALLBACK_URL=https://staging-api.smartskillhub.com/github/callback
GITHUB_TOKEN=your_staging_github_personal_access_token
CF_ACCOUNT_ID=
CF_API_TOKEN=
