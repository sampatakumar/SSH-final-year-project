# Smart Skill Hub — ResumeAI Backend Environment Configuration
PORT=8000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/resumeai

# Firebase Admin Authentication
FIREBASE_PROJECT_ID=smart-skill-hub

# Supabase Storage & Bucket Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_actual_service_role_key
SUPABASE_STORAGE_BUCKET=resumes

# Groq AI Model Configuration
# Available Models dynamically discovered: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Cloudflare & GitHub Credentials (Optional)
CF_ACCOUNT_ID=
CF_API_TOKEN=
GITHUB_TOKEN=

# YouTube Data API v3 (EduTube Module)
YOUTUBE_API_KEY=
