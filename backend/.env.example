# Smart Skill Hub — Backend Environment Configuration
PORT=8000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:8081
APP_BASE_URL=http://localhost:8081

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/smartskillhub

# Firebase Admin Authentication
FIREBASE_PROJECT_ID=smart-skill-hub
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email@smart-skill-hub.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_CONTINUE_URL=http://localhost:8081/auth/action

# Email Service Configuration (Providers: resend | smtp | console | mock)
EMAIL_PROVIDER=console
EMAIL_FROM="Smart Skill Hub <noreply@smartskillhub.com>"
EMAIL_FROM_NAME="Smart Skill Hub"
EMAIL_API_KEY=your_resend_or_smtp_api_key_here

# Supabase Storage & Bucket Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_actual_service_role_key
SUPABASE_STORAGE_BUCKET=resumes

# Groq AI Model Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Cloudflare & GitHub Credentials (Optional)
CF_ACCOUNT_ID=
CF_API_TOKEN=
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=

# YouTube Data API v3 (EduTube Module)
YOUTUBE_API_KEY=
